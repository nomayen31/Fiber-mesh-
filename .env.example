# ---------------------------------------------------------------------------
# Fiber Mesh - environment variables
# Copy this file to `.env` and fill in real values (never commit `.env`).
#
# Using Neon? `neon init` / `neon link` / `neon checkout` fill the DATABASE_URL
# values in for you automatically — you only need the ADMIN_*/NEXT_PUBLIC_* ones.
# ---------------------------------------------------------------------------

# --- Database (Neon / any PostgreSQL) -------------------------------------
# POOLED connection (hostname contains `-pooler`). Used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT / unpooled connection (no `-pooler`). Used only by Prisma Migrate,
# Prisma Studio and seed scripts, which need session state that PgBouncer
# transaction pooling does not provide. Wired up via `directUrl` in
# prisma/schema.prisma.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Written by the Neon CLI; informational.
NEON_BRANCH="production"

# Self-hosted Postgres instead? Then point BOTH variables at the same server:
# DATABASE_URL="postgresql://fibermesh:fibermesh@localhost:5432/fibermesh?schema=public"
# DATABASE_URL_UNPOOLED="postgresql://fibermesh:fibermesh@localhost:5432/fibermesh?schema=public"

# --- Admin dashboard auth --------------------------------------------------
# Password for /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD="changeme123"

# Secret used to sign the admin session cookie. Must be at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=YOUR_AUTH_SECRET

# --- Public business details (exposed to the browser) ----------------------
NEXT_PUBLIC_SITE_URL="https://fibermesh.com.bd"
NEXT_PUBLIC_PHONE="+8801718229955"
NEXT_PUBLIC_PHONE_DISPLAY="01718-229955"
# Digits only (country code + number, no + or spaces) — used for wa.me links.
NEXT_PUBLIC_WHATSAPP="8801718229955"
# Leave empty to hide the email row; the Facebook link is shown instead.
NEXT_PUBLIC_EMAIL=""
NEXT_PUBLIC_ADDRESS="ফেনী, ফেনী, বাংলাদেশ - ৩৯০০"
NEXT_PUBLIC_FACEBOOK="https://www.facebook.com/fibermeshbd"
NEXT_PUBLIC_BUSINESS_HOURS="শনিবার - বৃহস্পতিবার, সকাল ৯টা - রাত ৯টা"

# --- Firebase Analytics (optional but recommended) -------------------------
# This is a Next.js app: only NEXT_PUBLIC_* variables reach the browser bundle.
# Vite's `VITE_*` / `import.meta.env` does not work here.
# The Firebase web config is public by design. NEVER put Admin SDK
# service-account credentials in this file or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
