# ---------------------------------------------------------------------------
# Fiber Mesh - environment variables
# Copy this file to `.env` and fill in real values (never commit `.env`).
#
# Using Neon? `neon init` / `neon link` / `neon checkout` fill the DATABASE_URL
# values in for you automatically — you only need the ADMIN_*/NEXT_PUBLIC_* ones.
# ---------------------------------------------------------------------------

# --- Database (Neon / any PostgreSQL) -------------------------------------
# POOLED connection (hostname contains `-pooler`). Used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT / unpooled connection (no `-pooler`). Used only by Prisma Migrate,
# Prisma Studio and seed scripts, which need session state that PgBouncer
# transaction pooling does not provide. Wired up via `directUrl` in
# prisma/schema.prisma.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Written by the Neon CLI; informational.
NEON_BRANCH="production"

# Self-hosted Postgres instead? Then point BOTH variables at the same server:
# DATABASE_URL="postgresql://fibermesh:fibermesh@localhost:5432/fibermesh?schema=public"
# DATABASE_URL_UNPOOLED="postgresql://fibermesh:fibermesh@localhost:5432/fibermesh?schema=public"

# --- Admin dashboard auth --------------------------------------------------
# Password for /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD="changeme123"

# Secret used to sign the admin session cookie. Must be at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# REQUIRED in production. If it is missing, still the built-in development
# fallback, or shorter than 32 characters, the app refuses to sign or verify an
# admin session when NODE_ENV=production (it fails closed instead of using a
# signing key that is published in this repository).
AUTH_SECRET=YOUR_AUTH_SECRET

# --- Public business details (exposed to the browser) ----------------------
NEXT_PUBLIC_SITE_URL="https://fibermesh.com.bd"
NEXT_PUBLIC_PHONE="+8801718229955"
NEXT_PUBLIC_PHONE_DISPLAY="01718-229955"
# Digits only (country code + number, no + or spaces) — used for wa.me links.
NEXT_PUBLIC_WHATSAPP="8801718229955"
# Leave empty to hide the email row; the Facebook link is shown instead.
NEXT_PUBLIC_EMAIL=""
NEXT_PUBLIC_ADDRESS="ফেনী, ফেনী, বাংলাদেশ - ৩৯০০"
NEXT_PUBLIC_FACEBOOK="https://www.facebook.com/fibermeshbd"
NEXT_PUBLIC_BUSINESS_HOURS="শনিবার - বৃহস্পতিবার, সকাল ৯টা - রাত ৯টা"

# --- Firebase Analytics (optional but recommended) -------------------------
# This is a Next.js app: only NEXT_PUBLIC_* variables reach the browser bundle.
# Vite's `VITE_*` / `import.meta.env` does not work here.
# The Firebase web config is public by design. NEVER put Admin SDK
# service-account credentials in this file or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Push notifications for the Android lead app (all SERVER-ONLY) ----------
# These are read only by src/lib/notifications/*, which runs on the server.
# They are NOT NEXT_PUBLIC_* and must never be moved into a public variable:
# the service account can send a push to every registered device.
#
# Everything here is OPTIONAL. With none of it set, the website, the admin
# dashboard and the app all work normally — deliveries are just recorded as
# SKIPPED and the app's Settings screen says exactly what is missing.
# Full walkthrough: docs/FIREBASE_SETUP.md
# ---------------------------------------------------------------------------
# PREFERRED: the whole Firebase service-account JSON, either raw (starts with
# `{`) or base64-encoded. Base64 avoids newline/quote mangling in dashboards.
#   PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content -Raw .\key.json)))
#
# Paste the file EXACTLY as Firebase wrote it: the keys are snake_case
# (`project_id`, `client_email`, `private_key`). camelCase is also accepted, so
# either spelling works. If push stays off with no variable reported missing, the
# app's Settings screen and GET /api/admin/devices now say *why* (the sanitized
# `pushConfigIssue`: invalid JSON, a missing field name, a non-PEM private_key,
# or the Admin SDK rejecting the credential) - field names only, never a value.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Alternative: set these three instead of the blob above.
# FIREBASE_PRIVATE_KEY keeps its literal \n sequences exactly as they appear in
# the JSON file; the code converts them to real newlines.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Which events may produce a push, comma separated.
#   order.created    — an order row was successfully persisted   (on by default)
#   inquiry.created  — a contact-form row was persisted          (on by default)
#   order.confirmed  — a staff member moved an order to CONFIRMED (off by default:
#                      it would buzz the phone of whoever tapped it)
# `none` is a kill switch: nothing is ever pushed.
NOTIFY_EVENTS="order.created,inquiry.created"

# Enables GET/POST /api/cron/notifications, which retries undelivered pushes.
# Compared in constant time; accepts `Authorization: Bearer <secret>` (Vercel
# Cron) or `?secret=<secret>`. When unset the endpoint returns 503 — it is never
# left open, so it can't be abused as an anonymous "notify everyone" button.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Lifetime of the bearer token handed to the Android app, in seconds.
# Default 30 days (2592000). Clamped to a 90-day maximum. The website's cookie
# session is unaffected by this.
MOBILE_SESSION_MAX_AGE_SECONDS="2592000"
