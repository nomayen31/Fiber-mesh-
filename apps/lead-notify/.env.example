# ---------------------------------------------------------------------------
# apps/lead-notify — build-time environment for the Android app
#
# Copy to `.env` for local development. NEVER commit `.env`.
#
# Only `EXPO_PUBLIC_*` variables are readable from app code, and they are baked
# into the APK bundle at build time — so they must NOT contain secrets. This app
# deliberately holds no server credentials: it receives a short-lived bearer
# token from the backend after the admin types their password.
# ---------------------------------------------------------------------------

# Base URL of the existing Next.js backend.
#   - Production: your Vercel URL (no trailing slash).
#   - Local development on a physical phone: your PC's LAN address, e.g.
#     http://192.168.1.10:3000  ("localhost" would point at the phone itself.)
EXPO_PUBLIC_API_BASE_URL="https://fiber-mesh.vercel.app"

# Shown on the Settings screen so it is obvious which backend the APK targets.
EXPO_PUBLIC_ENV_LABEL="production"

# ---------------------------------------------------------------------------
# NOT set here, on purpose:
#
#   * Firebase Admin service-account credentials
#       → server-only, live on Vercel (see docs/FIREBASE_SETUP.md)
#   * google-services.json
#       → a file, not a variable; place it at apps/lead-notify/google-services.json
#         (git-ignored) — see docs/FIREBASE_SETUP.md
# ---------------------------------------------------------------------------
