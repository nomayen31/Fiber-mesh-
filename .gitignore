/exports

# vercel
.vercel
.neon

# ---------------------------------------------------------------------------
# apps/lead-notify — the Expo/React Native lead-notification app
#
# It is a *standalone* project (its own package.json and node_modules), not an
# npm workspace, so it can never affect the root install or the Vercel build.
# The root tsconfig.json excludes apps/ for the same reason.
# ---------------------------------------------------------------------------
/apps/lead-notify/node_modules
/apps/lead-notify/.expo
/apps/lead-notify/dist
/apps/lead-notify/web-build

# Native projects are generated by `expo prebuild` / EAS (CNG). Never commit them.
/apps/lead-notify/android
/apps/lead-notify/ios

# Build output and signing material — must never be committed.
/apps/lead-notify/*.apk
/apps/lead-notify/*.aab
/apps/lead-notify/*.keystore
/apps/lead-notify/*.jks

# Firebase *client* config. It is not a server secret, but it is environment
# specific; see docs/FIREBASE_SETUP.md.
/apps/lead-notify/google-services.json
/apps/lead-notify/GoogleService-Info.plist
